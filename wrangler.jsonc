{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "report-alf",
  "main": "./worker/report-alf.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
